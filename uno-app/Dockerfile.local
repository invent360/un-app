# UNO App Local Build Dockerfile
# For building with local path dependencies

# =============================================================================
# Stage 1: Build Environment
# =============================================================================
FROM rustlang/rust:nightly-bookworm-slim AS builder

# Install build dependencies (perl-modules and make needed for OpenSSL build)
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    perl \
    libfindbin-libs-perl \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install wasm target and cargo-leptos (latest version)
RUN rustup target add wasm32-unknown-unknown
RUN cargo install cargo-leptos --locked

# Create app directory
WORKDIR /app

# Copy local dependencies FIRST (for better caching)
COPY deps ./deps

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo

# Rewrite dependency paths for Docker build
RUN sed -i 's|path = "../../../../Dev-x/polkanight/ember/ember-fx/crates/|path = "./deps/ember-fx/crates/|g' Cargo.toml && \
    sed -i 's|path = "../uno-api"|path = "./deps/uno-api"|g' Cargo.toml && \
    sed -i 's|path = "../file-storage"|path = "./deps/file-storage"|g' Cargo.toml

# Copy actual source code
COPY src ./src
COPY assets ./assets
COPY style ./style
COPY end2end ./end2end
COPY migrations ./migrations

# Build the application
RUN cargo leptos build --release

# =============================================================================
# Stage 2: Runtime Environment
# =============================================================================
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -s /bin/false -u 1000 uno-app

# Create app directories
WORKDIR /app
RUN mkdir -p /app/site /data && chown -R uno-app:uno-app /app /data

# Copy built artifacts from builder
COPY --from=builder --chown=uno-app:uno-app /app/target/release/uno-app /app/
COPY --from=builder --chown=uno-app:uno-app /app/target/site /app/site

# Set environment variables
ENV LEPTOS_SITE_ROOT=/app/site
ENV LEPTOS_ENV=PROD
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1/health || exit 1

# Run as non-root user
USER uno-app

# Run the application
CMD ["./uno-app"]
